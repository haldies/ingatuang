<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_wallet"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fitur Quick Add dengan AI"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fitur Quick Add menggunakan AI untuk membantu Anda menambahkan transaksi dengan cepat dan mudah."
            android:textSize="15sp"
            android:textColor="#4b5563"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- What we do section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apa yang kami lakukan:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Memproses teks transaksi Anda secara lokal\n• Mendeteksi nominal, kategori, dan deskripsi otomatis\n• Menyimpan transaksi ke database lokal Anda"
            android:textSize="14sp"
            android:textColor="#6b7280"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Privacy section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privasi Anda:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Data transaksi Anda tetap di perangkat Anda\n• Kami tidak mengirim data ke server eksternal\n• Anda dapat menghapus data kapan saja"
            android:textSize="14sp"
            android:textColor="#6b7280"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp" />

        <!-- AI Improvement section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Peningkatan AI (Opsional):"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dengan persetujuan Anda, kami dapat menggunakan data transaksi yang telah dianonimkan untuk:"
            android:textSize="14sp"
            android:textColor="#6b7280"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Meningkatkan akurasi deteksi kategori\n• Memperbaiki parsing nominal dan deskripsi\n• Mengembangkan fitur AI yang lebih baik"
            android:textSize="14sp"
            android:textColor="#6b7280"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data yang digunakan akan dianonimkan dan tidak mengandung informasi pribadi Anda."
            android:textSize="13sp"
            android:textColor="#9ca3af"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_decline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tidak, Terima Kasih"
                android:textSize="15sp"
                android:textColor="#6b7280"
                android:background="@drawable/button_outline"
                android:layout_marginEnd="8dp"
                android:paddingVertical="14dp" />

            <Button
                android:id="@+id/btn_accept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Saya Setuju"
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:background="@drawable/button_primary"
                android:layout_marginStart="8dp"
                android:paddingVertical="14dp" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anda dapat mengubah preferensi ini kapan saja di Pengaturan"
            android:textSize="12sp"
            android:textColor="#9ca3af"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
