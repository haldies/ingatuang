<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="12dp"
    android:background="@drawable/input_background_modern"
    android:gravity="center">

    <!-- Subtle AI Status -->
    <TextView
        android:id="@+id/ai_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Siap"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:textColor="#3B82F6"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <!-- Main Visual Orb (Focal Point) -->
    <FrameLayout
        android:id="@+id/orb_container"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginBottom="12dp">

        <View
            android:id="@+id/orb_glow"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:alpha="0.4"
            android:background="@drawable/ai_orb_glow" />

        <View
            android:id="@+id/voice_button_orb"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/ai_orb_background" />

        <!-- Waveform Bars (Animatable) -->
        <LinearLayout
            android:id="@+id/waveform_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View android:id="@+id/wave_bar_1" android:layout_width="4dp" android:layout_height="8dp" android:layout_marginHorizontal="2dp" android:background="@drawable/waveform_bar" />
            <View android:id="@+id/wave_bar_2" android:layout_width="4dp" android:layout_height="16dp" android:layout_marginHorizontal="2dp" android:background="@drawable/waveform_bar" />
            <View android:id="@+id/wave_bar_3" android:layout_width="4dp" android:layout_height="24dp" android:layout_marginHorizontal="2dp" android:background="@drawable/waveform_bar" />
            <View android:id="@+id/wave_bar_4" android:layout_width="4dp" android:layout_height="16dp" android:layout_marginHorizontal="2dp" android:background="@drawable/waveform_bar" />
            <View android:id="@+id/wave_bar_5" android:layout_width="4dp" android:layout_height="8dp" android:layout_marginHorizontal="2dp" android:background="@drawable/waveform_bar" />
        </LinearLayout>

    </FrameLayout>

    <!-- Minimized Input (Initially Hidden) -->
    <EditText
        android:id="@+id/input_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="..."
        android:textSize="16sp"
        android:textColor="#111827"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:padding="12dp"
        android:background="@drawable/edit_text_background"
        android:textColorHint="#94A3B8"
        android:visibility="gone"
        android:layout_marginBottom="24dp" />

    <!-- Minimal Action Buttons (Initially Hidden) -->
    <LinearLayout
        android:id="@+id/actions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Batal"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:background="@drawable/button_cancel_modern"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/submit_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.5"
            android:text="Simpan"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_primary_modern"
            android:textAllCaps="false"
            android:layout_marginStart="6dp" />

    </LinearLayout>


    <TextView android:id="@+id/ai_instruction" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/voice_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>

